<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 equivalent of data_extraction_rules.xml: the business database and
  files hold customer credentials and must never be included in automatic backups.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
